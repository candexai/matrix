{
  "name": "matrix-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Matrix x CandexAI backend — ElevenLabs voice agents, Zoho CRM leads, conversations, analytics",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:pipeline": "ts-node --transpile-only src/scripts/testPostCallPipeline.ts",
    "zoho:bridge": "node scripts/zoho-oauth-bridge.mjs"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.17.0",
    "mongodb-memory-server": "^10.4.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
