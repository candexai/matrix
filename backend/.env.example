# ---- Server ----
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL of THIS backend (ngrok/cloudflared). Required for ElevenLabs post-call webhooks and Zoho OAuth callback.
PUBLIC_BACKEND_URL=http://localhost:5001

# ---- MongoDB ----
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?appName=<app>
DB_NAME=matrix

# ---- ElevenLabs ----
# Each workspace connects its OWN API key from the UI (Integrations → ElevenLabs; stored encrypted).
# The env key below is optional and only serves the legacy bootstrap workspace ("default").
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io
# Optional: your Python FastAPI ElevenLabs wrapper (holds its own copy of the env key, so it is only
# used for the env-backed "default" workspace). When set and reachable, agent create/update go through it.
ELEVENLABS_SERVICE_URL=http://127.0.0.1:8000

# ---- Accounts ----
# Every sign-up gets a fresh workspace. Optional: the email that should own the legacy "default"
# workspace (data created before accounts existed) when it signs up and nobody owns it yet.
BOOTSTRAP_OWNER_EMAIL=
# Move an existing user later: npm run build && npm run auth:assign-workspace -- --email <email> --workspace <id|new>

# ---- Zoho CRM (create a Server-based app at https://api-console.zoho.com) ----
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# Defaults to ${PUBLIC_BACKEND_URL}/api/v1/integrations/zoho/callback
ZOHO_REDIRECT_URI=

# ---- Security ----
# 32+ chars; used to encrypt OAuth tokens + webhook secrets at rest
ENCRYPTION_KEY=change-me-32-chars-minimum

# Set to false to disable the in-memory MongoDB fallback in development
DB_MEMORY_FALLBACK=true

# ---- OpenAI (post-call transcript extraction) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
