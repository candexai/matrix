# Matrix × CandexAI — nginx site config (rendered by setup-server.sh)
# Frontend (Next.js) on 127.0.0.1:3000, backend (Express) on 127.0.0.1:5001.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    client_max_body_size 20m;

    # --- unauthenticated endpoints: ElevenLabs post-call webhook, Zoho OAuth callback, health ---
    location /api/v1/webhooks/ {
        proxy_pass http://127.0.0.1:5001;
        include /etc/nginx/snippets/matrix-proxy.conf;
    }
    location = /api/v1/integrations/zoho/callback {
        proxy_pass http://127.0.0.1:5001;
        include /etc/nginx/snippets/matrix-proxy.conf;
    }
    location = /health {
        proxy_pass http://127.0.0.1:5001;
        include /etc/nginx/snippets/matrix-proxy.conf;
    }

    # --- API ---
    location /api/ {
        auth_basic "Matrix";
        auth_basic_user_file /etc/nginx/matrix.htpasswd;
        proxy_pass http://127.0.0.1:5001;
        include /etc/nginx/snippets/matrix-proxy.conf;
        proxy_buffering off;              # audio streaming
        proxy_read_timeout 180s;
    }

    # --- Next.js app ---
    location / {
        auth_basic "Matrix";
        auth_basic_user_file /etc/nginx/matrix.htpasswd;
        proxy_pass http://127.0.0.1:3000;
        include /etc/nginx/snippets/matrix-proxy.conf;
    }
}
